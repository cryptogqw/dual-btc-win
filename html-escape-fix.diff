+// ── 数据质量横幅：让「静默失效」不可能发生 ──
+function renderDataQuality(meta) {
+  const el = document.getElementById('dataQualityBanner');
+  if (!el) return;
+  const issues = (meta && meta.dataQuality) || [];
+  if (!issues.length) { el.style.display = 'none'; return; }
+  const hasError = issues.some(i => i.level === 'error');
+  el.className = hasError ? 'error' : 'warn';
+  el.style.display = 'block';
+  const title = hasError
+    ? (currentLang === 'en' ? 'Some risk checks are NOT active' : '部分风控检查当前未生效')
+    : (currentLang === 'en' ? 'Data quality warnings' : '数据质量提醒');
+  el.innerHTML = '<div class="dq-title">' + (hasError ? '\u26D4 ' : '\u26A0\uFE0F ') + title + '</div><ul>'
+    + issues.map(i => '<li>' + escHTML(i.msg) + '</li>').join('') + '</ul>';
+}
